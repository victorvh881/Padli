# Verbinding met de PostgreSQL-database (bv. van Neon).
DATABASE_URL="postgresql://padoo:padoo@localhost:5432/padoo"
# Directe verbinding voor migraties (bij Neon: de URL zonder "-pooler").
DATABASE_URL_UNPOOLED="postgresql://padoo:padoo@localhost:5432/padoo"
# Het adres van de website, zonder / op het einde.
APP_URL="http://localhost:3000"

# Optioneel: e-mail via Brevo. Zonder sleutel worden nieuwe accounts meteen
# geactiveerd en verschijnen e-mails alleen in de serverlog.
BREVO_API_KEY=""
EMAIL_FROM="noreply@padoo.be"

# Optioneel: eerste beheerder, aangemaakt door "npm run db:seed".
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Neon Object Storage (bucket "uploads"). Wordt ingevuld door "neon deploy".
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
